# Normalise line endings.
#
# Without this, a Windows clone with core.autocrlf=true gets CRLF in the working
# tree while the repo stores LF. Prettier is configured for LF, so
# `npm run format:check` then reports dozens of files as unformatted that are
# perfectly fine in CI — and the reverse is also possible, which is worse: a
# real formatting failure hiding among false ones.
#
# `text=auto eol=lf` makes the working tree match the repository on every
# platform, so local and CI see the same bytes.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
