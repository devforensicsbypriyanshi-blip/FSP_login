# =============================================================================
# FSP Platform — environment variables
#
# Copy this file to .env.local for local development.
# In production, add these in Vercel → Settings → Environment Variables.
#
# NEVER commit .env.local. Never paste a secret into chat or a screenshot.
#
# Setup guide for email: docs/08-EMAIL-SETUP.md
# =============================================================================


# =============================================================================
# REQUIRED — the platform will not run without these
# =============================================================================

# --- Site --------------------------------------------------------------------
# Production: https://app.forensicbypriyanshi.com
# Local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=


# --- Supabase ----------------------------------------------------------------
# Supabase → Project Settings → API

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key — safe to be public, protected by security rules
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SECRET. Bypasses all security rules. Server only.
SUPABASE_SERVICE_ROLE_KEY=


# --- Email · Amazon SES ------------------------------------------------------
# From IAM → Users → fsp-ses-app → Security credentials → Access keys
#
# Replace the two PASTE_ values below, keep everything else, paste as ONE line:
#
# [{"id":"ses","provider":"ses","region":"ap-south-1",
#   "key":"PASTE_ACCESS_KEY_ID",
#   "secret":"PASTE_SECRET_ACCESS_KEY",
#   "from":"no-reply@fspmail.forensicbypriyanshi.com",
#   "dailyCap":2000,"monthlyCap":50000,"priority":0}]
#
# dailyCap/monthlyCap are a spend guard, not an SES limit — they stop a runaway
# loop rather than bill you.
EMAIL_POOLS=


# --- Cron --------------------------------------------------------------------
# Protects the job that sends reminders. The worker refuses EVERY request
# without it, on purpose.
# Generate one:  openssl rand -base64 32
CRON_SECRET=


# =============================================================================
# RECOMMENDED — everything works without these, some things work better with
# =============================================================================

# --- Session -----------------------------------------------------------------
# Speeds up the device/role check from once per request to once per minute.
# Optional: slower without it, never less safe.
# Generate one:  openssl rand -base64 32
SESSION_COOKIE_SECRET=
SESSION_CHECK_TTL_SECONDS=60


# --- Payments · Razorpay -----------------------------------------------------
# Razorpay → Settings → API Keys. Use rzp_test_* until the account is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay → Settings → Webhooks → Add New Webhook
#   URL     https://app.forensicbypriyanshi.com/api/webhooks/razorpay
#   Events  payment.captured, payment.failed
#   Secret  you choose it there, then paste it here
#
# This webhook is what grants course access. Wrong URL = students pay and are
# never enrolled.
RAZORPAY_WEBHOOK_SECRET=


# --- Push notifications · Firebase -------------------------------------------
# Firebase Console → Project settings → General → Your apps → Web app
# These five are public by design — they ship in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → Cloud Messaging → Web Push certificates → key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# SECRET. Firebase Console → Project settings → Service accounts →
# Generate new private key. Then base64-encode the downloaded JSON:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=


# =============================================================================
# OPTIONAL — not needed for launch
# =============================================================================

# --- Cloudinary · course banners and thumbnails ------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry · error tracking -------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Upstash Redis · rate limiting -------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Demo mode ---------------------------------------------------------------
# Lets you browse the portals WITHOUT signing in. Never set this in production.
# NEXT_PUBLIC_SHOW_HUB=true


# --- SES bounce & complaint reporting (SNS) ----------------------------------
#
# SES has no webhook. Bounces and complaints are published to an SNS topic which
# POSTs to https://app.forensicbypriyanshi.com/api/webhooks/ses
#
# THIS IS THE SECURITY CONTROL, not a nicety. Anyone with an AWS account can
# create a topic and subscribe our URL to it, and their messages carry a valid
# AWS signature. A forged bounce adds a real student to the suppression list,
# and a suppressed address stops receiving sign-in codes — so a forged bounce
# locks a named person out of the platform.
#
# The endpoint refuses everything unless the topic ARN is listed here. Leaving
# this blank means bounce reporting is off, not open.
#
# Copy the ARN from SNS → Topics. Comma-separate if you use one topic for
# bounces and another for complaints.
SES_SNS_TOPIC_ARNS=arn:aws:sns:ap-south-1:000000000000:fsp-ses-events

# =============================================================================
# NOT IN USE — kept so the code still runs if you ever switch providers
# =============================================================================

# Resend. Only read when EMAIL_POOLS above is empty. You are on SES now.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_DAILY_CAP=100
EMAIL_MONTHLY_CAP=3000

# Resend delivery webhooks — one secret per account, comma-separated.
# Unused on SES: AWS reports bounces through SNS, not this endpoint.
RESEND_WEBHOOK_SECRETS=
RESEND_WEBHOOK_SECRET=

# Self-hosted Web Push, as an alternative to Firebase.
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@forensicbypriyanshi.com
